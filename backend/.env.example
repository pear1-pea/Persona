PORT=8080
DATABASE_URL=postgres://persona:change-me@127.0.0.1:5432/persona
# Optional for auth and Persona endpoints; chat returns 503 until configured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-v4-flash
MAX_REQUESTS_PER_MINUTE=30
MAX_AUTH_REQUESTS_PER_MINUTE=10
MAX_MESSAGES=24
MAX_MESSAGE_CHARS=12000
MAX_OUTPUT_TOKENS=1024
MAX_DAILY_INPUT_CHARS=200000
MAX_DAILY_OUTPUT_TOKENS=30000
MAX_CHAT_CONCURRENT_PER_USER=1
MAX_CHAT_CONCURRENT_GLOBAL=20
CHAT_UPSTREAM_TIMEOUT_MS=120000
SESSION_TTL_DAYS=30
TRUST_PROXY=false
