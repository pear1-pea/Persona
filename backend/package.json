{
  "name": "persona-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/validation.test.ts test/security.test.ts test/dto.test.ts test/chat-stream.test.ts scripts/smoke-auth.test.mjs",
    "test:integration": "node --import tsx --test test/chat.integration.test.ts test/chat-budget.integration.test.ts",
    "smoke": "node scripts/smoke-auth.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
